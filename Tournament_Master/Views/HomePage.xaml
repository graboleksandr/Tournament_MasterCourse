<Page x:Class="Tournament_Master.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Home" Background="{DynamicResource WindowBg}"
      SnapsToDevicePixels="True" 
      UseLayoutRounding="True"
      TextOptions.TextFormattingMode="Display">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,40">
            <Border Background="{DynamicResource SidebarBg}" CornerRadius="12" Padding="15,8" BorderBrush="{DynamicResource HoverColor}" BorderThickness="1">
                <TextBlock x:Name="LblWelcomeMessage" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryText}" VerticalAlignment="Center">
                    <Run Text="{DynamicResource m_LoggedInAs}"/>
                    <Run x:Name="RunUser" Text=""/>
                </TextBlock>
            </Border>

            <Button Content="{DynamicResource m_Logout}" Click="BtnLogout_Click" Margin="15,0,0,0"
                    Foreground="#D32F2F" Background="Transparent" BorderThickness="0" 
                    FontWeight="Bold" Cursor="Hand" VerticalAlignment="Center"
                    FocusVisualStyle="{x:Null}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="TOURNAMENT MASTER" 
                   FontSize="36" FontWeight="Black" Foreground="{DynamicResource AccentColor}" 
                   HorizontalAlignment="Center" Margin="0,0,0,40">
            <TextBlock.Effect>
                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15" Color="Black"/>
            </TextBlock.Effect>
        </TextBlock>

        <Grid Grid.Row="2" VerticalAlignment="Top" MaxWidth="1000" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{DynamicResource m_CreateNewTournament}" FontSize="20" 
                       FontWeight="Bold" Foreground="{DynamicResource PrimaryText}" Margin="5,0,0,20"/>

            <UniformGrid Grid.Row="1" Columns="2" Rows="2">

                <Button x:Name="BtnCreateRoundRobin" Click="BtnCreateRoundRobin_Click" Margin="0,0,15,15" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cardBorder" Background="{DynamicResource SidebarBg}" CornerRadius="16" Padding="25" BorderThickness="1" BorderBrush="{DynamicResource HoverColor}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource m_RoundRobinIndivTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>
                                    <Border CornerRadius="12" ClipToBounds="True" Height="130" Background="#FFFBF0" Padding="8" Margin="0,0,0,12">
                                        <Image Source="/Resources/Images/round_robin.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource m_RoundRobinIndivDesc}" FontSize="14" Foreground="{DynamicResource PrimaryText}" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource HoverColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnCreateElimination" Click="BtnCreateElimination_Click" Margin="15,0,0,15" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cardBorder" Background="{DynamicResource SidebarBg}" CornerRadius="16" Padding="25" BorderThickness="1" BorderBrush="{DynamicResource HoverColor}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource m_SingleElimTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>
                                    <Border CornerRadius="12" ClipToBounds="True" Height="130" Background="#FFFBF0" Padding="8" Margin="0,0,0,12">
                                        <Image Source="/Resources/Images/playoff.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource m_SingleElimDesc}" FontSize="14" Foreground="{DynamicResource PrimaryText}" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource HoverColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnCreateTeamRoundRobin" Click="BtnCreateTeamRoundRobin_Click" Margin="0,15,15,0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cardBorder" Background="{DynamicResource SidebarBg}" CornerRadius="16" Padding="25" BorderThickness="1" BorderBrush="{DynamicResource HoverColor}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource m_RoundRobinTeamTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>
                                    <Border CornerRadius="12" ClipToBounds="True" Height="130" Background="#FFFBF0" Padding="8" Margin="0,0,0,12">
                                        <Image Source="/Resources/Images/round_robin.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource m_RoundRobinTeamDesc}" FontSize="14" Foreground="{DynamicResource PrimaryText}" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource HoverColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnCreateTeamElimination" Click="BtnCreateTeamElimination_Click" Margin="15,15,0,0" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="cardBorder" Background="{DynamicResource SidebarBg}" CornerRadius="16" Padding="25" BorderThickness="1" BorderBrush="{DynamicResource HoverColor}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource m_TeamElimTitle}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,12"/>
                                    <Border CornerRadius="12" ClipToBounds="True" Height="130" Background="#FFFBF0" Padding="8" Margin="0,0,0,12">
                                        <Image Source="/Resources/Images/playoff.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource m_TeamElimDesc}" FontSize="14" Foreground="{DynamicResource PrimaryText}" Opacity="0.7" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                                    <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource HoverColor}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </UniformGrid>
        </Grid>
    </Grid>
</Page>