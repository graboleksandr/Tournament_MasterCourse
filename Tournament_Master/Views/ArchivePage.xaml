<Page x:Class="Tournament_Master.Views.ArchivePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{DynamicResource WindowBg}"
      SnapsToDevicePixels="True" 
      UseLayoutRounding="True"
      TextOptions.TextFormattingMode="Display">

    <Grid Margin="30,25,30,25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource m_ArchiveHeader}" 
                   Foreground="{DynamicResource PrimaryText}" 
                   FontSize="20" FontWeight="Bold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="TournamentsCards" Margin="10,0,10,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ItemBorder" Height="75" Margin="0,5,0,5" 
                                Background="{DynamicResource SidebarBg}" CornerRadius="14" 
                                Cursor="Hand" MouseDown="ItemBorder_MouseDown">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.02" Color="Black"/>
                            </Border.Effect>

                            <Grid Margin="20,0,15,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="{Binding Icon, TargetNullValue='🏆'}" FontSize="22" VerticalAlignment="Center" Margin="0,0,20,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtTitleBlock" Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" FontSize="16" TextTrimming="CharacterEllipsis"/>

                                    <TextBox x:Name="TxtTitleInput" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource WindowBg}" Foreground="{DynamicResource PrimaryText}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" FontSize="15" Padding="5,3" Visibility="Collapsed" KeyDown="TxtTitleInput_KeyDown" LostFocus="TxtTitleInput_LostFocus" HorizontalAlignment="Left" MinWidth="250" MaxWidth="450"/>

                                    <TextBlock Text="{Binding Info}" Foreground="{DynamicResource PrimaryText}" Opacity="0.5" FontSize="13" Margin="0,4,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2" Text="{Binding Date}" Foreground="{DynamicResource PrimaryText}" Opacity="0.4" FontSize="13" VerticalAlignment="Center" Margin="0,0,25,0"/>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnEditToggle" 
                                            Content="Редагувати" 
                                            Margin="0,0,12,0" 
                                            Background="Transparent" 
                                            BorderThickness="0" 
                                            Foreground="{DynamicResource AccentColor}" 
                                            FontSize="13" 
                                            FontWeight="SemiBold" 
                                            Cursor="Hand" 
                                            Click="BtnEditToggle_Click" 
                                            FocusVisualStyle="{x:Null}"/>

                                    <Button Content="✕" Width="36" Height="36" Background="Transparent" BorderThickness="0" Foreground="#D32F2F" FontSize="13" FontWeight="Bold" Cursor="Hand" Click="BtnDelete_Click" FocusVisualStyle="{x:Null}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DataTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True" SourceName="ItemBorder">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverColor}"/>
                            </Trigger>

                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter TargetName="TxtTitleBlock" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="TxtTitleInput" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BtnEditToggle" Property="Content" Value="Зберегти"/>
                                <Setter TargetName="BtnEditToggle" Property="Foreground" Value="#2E7D32"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>